# База данных PostgreSQL (docker-compose)
DATABASE_URL=postgresql://chatbot:chatbot@127.0.0.1:55432/chatbot

# Redis для очереди событий и pub/sub превью (docker-compose)
REDIS_URL=redis://127.0.0.1:56379

# Секрет подписи JWT для авторизации авторов
JWT_SECRET=change-me-dev-jwt-secret

# Ключи SecretVault: base64, ровно 32 байта
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
VAULT_HASH_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Telegram-бот для локальной отладки
TELEGRAM_DEV_TOKEN=
# 1 — long polling вместо webhook (для локальной отладки и сетей, куда Telegram не может достучаться; одна копия api)
TELEGRAM_POLLING=1

# Публичный адрес API для webhook Telegram (обязателен в production при TELEGRAM_POLLING=0)
PUBLIC_URL=http://localhost:3000

# Порт HTTP API
API_PORT=3000
