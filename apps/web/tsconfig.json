{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@chatbot/model": ["../../packages/model/src/index.ts"],
      "@chatbot/engine-core": ["../../packages/engine-core/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
