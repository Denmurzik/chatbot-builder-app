    "@chatbot/queue": "workspace:*",
    "@chatbot/vault": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "bullmq": "^5.34.3",
    "dotenv": "^16.4.7",
    "grammy": "^1.33.0",
    "ioredis": "^5.4.2",
    "p-retry": "^4.6.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
