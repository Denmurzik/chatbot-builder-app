{
  "name": "@chatbot/api",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -b && node --enable-source-maps dist/main.js",
    "seed:dev": "tsx scripts/seed-dev.ts",
    "start": "node dist/main.js",
    "test": "vitest run --root ../.. --project api apps/api"
  },
  "dependencies": {
    "@chatbot/db": "workspace:*",
    "@chatbot/engine-core": "workspace:*",
    "@chatbot/model": "workspace:*",
    "@chatbot/queue": "workspace:*",
    "@chatbot/vault": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/websockets": "^10.4.15",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "grammy": "^1.33.0",
    "ioredis": "^5.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "undici": "^6.21.1",
    "yaml": "^2.9.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.2",
    "socket.io-client": "4.8.1",
    "supertest": "^7.0.0"
  }
}
