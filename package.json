{
  "name": "chatbot-builder",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b packages/model packages/engine-core packages/vault packages/db packages/queue apps/api apps/engine apps/mock-clinic && pnpm --filter @chatbot/web build",
    "test": "vitest run --project packages --project api --project engine --project web",
    "test:int": "vitest run --project integration --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:load": "tsx scripts/load-test.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b packages/model packages/engine-core packages/vault packages/db packages/queue apps/api apps/engine apps/mock-clinic && tsc -p apps/engine/tsconfig.test.json --noEmit && pnpm --filter @chatbot/web typecheck",
    "arch": "depcruise --config .dependency-cruiser.cjs \"packages/*/src\" \"apps/*/src\"",
    "arch:graph": "depcruise --config .dependency-cruiser.cjs --output-type archi --output-to docs/architecture/modules.dot \"packages/*/src\" \"apps/*/src\"",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "dev:api": "pnpm --filter @chatbot/api dev",
    "dev:engine": "pnpm --filter @chatbot/engine dev",
    "dev:web": "pnpm --filter @chatbot/web dev",
    "dev:mock-clinic": "pnpm --filter @chatbot/mock-clinic dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.65.1",
    "@swc/core": "~1.10.18",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.8.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.18.1",
    "unplugin-swc": "^1.5.0",
    "vitest": "^2.1.8"
  }
}
