# Копия этого файла — deploy/.env.prod (в git не попадает).
# Все значения обязательны: пустое остановит запуск.
NODE_ENV=production
PUBLIC_URL=https://chatbot.nsumonkey.top
# 0 — webhook (по умолчанию), 1 — long polling для сетей, куда Telegram не может достучаться (одна копия api)
TELEGRAM_POLLING=0

# Пароль PostgreSQL. Только hex: символы / и + из base64 ломают DATABASE_URL.
# Генерация: openssl rand -hex 32
POSTGRES_PASSWORD=

# Секрет JWT, не короче 32 символов. Генерация: openssl rand -base64 32
JWT_SECRET=

# Ключи SecretVault: base64, ровно 32 байта; общие у api и engine. После первого запуска не менять.
# Генерация каждого: openssl rand -base64 32
VAULT_KEY=
VAULT_HASH_KEY=

# Ключ тестового API клиники (заголовок X-Api-Key). Генерация: openssl rand -hex 16
MOCK_CLINIC_API_KEY=

# Хосты (через запятую), на которые бот может отправлять HTTP-запросы. По умолчанию — только mock-clinic.
# Чтобы разрешить реальный внешний API, добавьте его имя хоста: mock-clinic,api.example.com
HTTP_ALLOWED_HOSTS=mock-clinic

# Необязательный HTTP-прокси для исходящих запросов к api.telegram.org (пусто — прямые запросы).
# С контейнером telegram-proxy из профиля --profile telegram-proxy: http://telegram-proxy:10809
TELEGRAM_PROXY=
