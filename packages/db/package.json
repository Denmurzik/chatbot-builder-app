{
  "name": "@chatbot/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project packages packages/db",
    "db:generate": "node scripts/prisma-env.js generate",
    "postinstall": "prisma generate",
    "db:migrate": "node scripts/prisma-env.js migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
